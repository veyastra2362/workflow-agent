{
  "name": "workflow-agent",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的通用工作流 Agent 桌面应用",
  "author": "veyastra2362",
  "repository": {
    "type": "git",
    "url": "https://github.com/veyastra2362/workflow-agent.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dist": "pnpm build && electron-builder --win --x64",
    "dist:dir": "pnpm build && electron-builder --win --x64 --dir",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "diff": "^7.0.0",
    "playwright": "1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^37.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
