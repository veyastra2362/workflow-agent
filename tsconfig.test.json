{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/core/**/*.ts",
    "src/gateway/**/*.ts",
    "src/tools/**/*.ts",
    "src/policy/**/*.ts",
    "src/persistence/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
